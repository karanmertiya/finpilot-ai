# FinPilot AI Environment Configuration

# Core Application
APP_ENV=development
DEBUG=true
PROJECT_NAME="FinPilot AI"
SECRET_KEY=finpilot-insecure-dev-secret-key-32chars-minimum-prod-override!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# Default: SQLite for zero-setup local dev/testing
# Production / Docker Compose: postgresql://finpilot:finpilot_pass@postgres:5432/finpilot_db
DATABASE_URL=sqlite:///./finpilot.db

# LLM Provider Configuration (gemini, openai, anthropic, mock)
# When set to mock, deterministic responses with exact verified figures are provided without requiring API credits!
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding Provider (local, gemini, openai)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-004

# Observability and Limits
MAX_AGENT_STEPS=5
MAX_RETRIEVAL_CHUNKS=4
SIMILARITY_THRESHOLD=0.35
MAX_UPLOAD_FILE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=60

# Frontend & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
